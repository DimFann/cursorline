<Window x:Class="CursorLine.CustomizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize line" Height="760" Width="430"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Line appearance" FontSize="16" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Color" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ColorPreview" Width="36" Height="26" BorderBrush="#777777" BorderThickness="1" />
                <Button Content="Choose color..." Margin="10,0,0,0" Padding="10,4" Click="ChooseColor_Click" />
                <TextBlock x:Name="ColorHexText" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Width" VerticalAlignment="Center" />
            <TextBox x:Name="LineWidthInput" Grid.Column="1" Width="90" Padding="5,3"
                     TextChanged="LineWidthInput_TextChanged" />
            <TextBlock Grid.Column="2" Text="pixels (1-100)" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <CheckBox x:Name="DrawLineInput" Grid.Row="3" Margin="0,14,0,0"
                  Content="Draw main line" Checked="DrawLine_Changed"
                  Unchecked="DrawLine_Changed" />
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Display" VerticalAlignment="Center" />
            <ComboBox x:Name="DisplayInput" Grid.Column="1" Padding="5,3" DisplayMemberPath="DisplayName"
                      SelectedValuePath="DeviceName" SelectionChanged="DisplayInput_SelectionChanged" />
        </Grid>
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Start corner" VerticalAlignment="Center" />
            <ComboBox x:Name="StartCornerInput" Grid.Column="1" Padding="5,3" SelectedValuePath="Tag"
                      SelectionChanged="StartCornerInput_SelectionChanged">
                <ComboBoxItem Content="Top left" Tag="TopLeft" />
                <ComboBoxItem Content="Top right" Tag="TopRight" />
                <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
            </ComboBox>
        </Grid>
        <CheckBox x:Name="WhitelistEnabledInput" Grid.Row="6" Margin="0,14,0,0"
                  Content="Only show on whitelisted applications"
                  Checked="WhitelistEnabled_Changed" Unchecked="WhitelistEnabled_Changed" />
        <StackPanel Grid.Row="7" Margin="0,8,0,0">
            <TextBlock Text="Application process names" Margin="0,0,0,5" />
            <ListBox x:Name="WhitelistedAppsList" Height="76" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ApplicationNameInput" Padding="5,3"
                         ToolTip="Enter an executable name, with or without .exe" />
                <Button Grid.Column="1" Content="Add" MinWidth="62" Margin="6,0,0,0"
                        Padding="8,4" Click="AddWhitelistApplication_Click" />
                <Button Grid.Column="2" Content="Remove" MinWidth="72" Margin="6,0,0,0"
                        Padding="8,4" Click="RemoveWhitelistApplication_Click" />
            </Grid>
        </StackPanel>
        <CheckBox x:Name="DrawCursorCircleInput" Grid.Row="8" Margin="0,14,0,0"
                  Content="Draw circle around cursor" Checked="DrawCursorCircle_Changed"
                  Unchecked="DrawCursorCircle_Changed" />
        <Grid Grid.Row="9" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Circle radius" VerticalAlignment="Center" />
            <TextBox x:Name="CircleRadiusInput" Grid.Column="1" Width="90" Padding="5,3"
                     TextChanged="CircleRadiusInput_TextChanged" />
            <TextBlock Grid.Column="2" Text="pixels (1-2000)" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <CheckBox x:Name="BigCursorEnabledInput" Grid.Row="10" Margin="0,14,0,0"
                  Content="Enable big cursor" Checked="BigCursorEnabled_Changed"
                  Unchecked="BigCursorEnabled_Changed" />
        <Grid Grid.Row="11" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PNG image" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Import PNG..." Padding="10,4"
                    Click="ImportBigCursorImage_Click" />
            <TextBlock x:Name="BigCursorImageName" Grid.Column="2" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Grid Grid.Row="12" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Image scale" VerticalAlignment="Center" />
            <Slider x:Name="BigCursorScaleInput" Grid.Column="1" Minimum="16" Maximum="512"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="BigCursorScaleInput_ValueChanged" />
            <TextBlock x:Name="BigCursorScaleText" Grid.Column="2" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="13" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rotation" VerticalAlignment="Center" />
            <Slider x:Name="BigCursorRotationInput" Grid.Column="1" Minimum="0" Maximum="360"
                    ValueChanged="BigCursorRotationInput_ValueChanged" />
            <TextBlock x:Name="BigCursorRotationText" Grid.Column="2" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="ValidationMessage" Grid.Row="14" Margin="0,10,0,0"
                   Foreground="Firebrick" TextWrapping="Wrap" VerticalAlignment="Top" />
        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="76" Margin="0,0,8,0" Padding="10,5" Click="Cancel_Click" />
            <Button Content="Save" MinWidth="76" Padding="10,5" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
